---
const nav = [
  ['About', 'about'],
  ['Projects', 'projects'],
  ['Research', 'research'],
  ['Open Source', 'open-source'],
  ['Contact', 'contact'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#090b10" />
    <meta name="description" content="OpenSource Lab — open technology, research and collaborative software." />
    <title>OpenSource Lab — Open Technology & Research</title>
  </head>
  <body>
    <div class="noise"></div>
    <div class="grid"></div>
    <div class="scanline"></div>

    <header class="topbar">
      <a class="brand" href="#top" aria-label="OpenSource Lab home">
        <span class="brand-mark"><span></span><span></span><span></span></span>
        <span>OpenSource <b>Lab</b></span>
      </a>
      <nav aria-label="Primary navigation">
        {nav.map(([label, id]) => <a href={`#${id}`}>{label}</a>)}
      </nav>
      <div class="status"><i></i> OPEN LAB</div>
    </header>

    <main id="top">
      <section class="hero section-frame">
        <div class="hud hud-tl">SYS / 01</div>
        <div class="hud hud-tr">IND / OPEN</div>
        <div class="hero-copy">
          <p class="eyebrow">OPEN TECHNOLOGY · RESEARCH · COLLABORATION</p>
          <h1>Build in the open.<br /><span>Think beyond.</span></h1>
          <p class="lede">OpenSource Lab is a collaborative technology space for building useful software, exploring new ideas, and sharing the work behind them.</p>
          <div class="hero-actions">
            <a class="button primary" href="#projects">Explore projects <span>↗</span></a>
            <a class="button ghost" href="#about">Learn about the lab</a>
          </div>
        </div>
        <div class="hero-orbit" aria-hidden="true">
          <div class="orbit o1"></div><div class="orbit o2"></div><div class="orbit o3"></div>
          <div class="core">OSL</div>
        </div>
        <div class="hud hud-bl">BUILD / SHIP / SHARE</div>
        <div class="hud hud-br">v1.0 / 2026</div>
      </section>

      <section id="about" class="content-section">
        <div class="section-tag">01 — ABOUT</div>
        <div class="section-head"><h2>A lab for ideas<br />that should exist.</h2><p>Small teams, independent builders, researchers and contributors can use the lab as a home for practical experimentation.</p></div>
        <div class="feature-grid">
          <article><span>01</span><h3>Open by default</h3><p>Source, documentation and decisions stay visible wherever practical.</p></article>
          <article><span>02</span><h3>Useful over noisy</h3><p>Projects are focused on solving real problems with thoughtful engineering.</p></article>
          <article><span>03</span><h3>Built together</h3><p>Contributors can inspect, improve, fork and extend what we publish.</p></article>
        </div>
      </section>

      <section id="projects" class="content-section dark-panel">
        <div class="section-tag">02 — PROJECTS</div>
        <div class="section-head"><h2>Selected work</h2><p>A growing collection of tools, experiments and open infrastructure.</p></div>
        <div class="project-list">
          <a class="project-row" href="#contact"><span class="mono">01</span><div><h3>Open Tools</h3><p>Practical developer utilities and small systems.</p></div><span class="arrow">↗</span></a>
          <a class="project-row" href="#contact"><span class="mono">02</span><div><h3>Research Prototypes</h3><p>Fast-moving experiments exploring new technical directions.</p></div><span class="arrow">↗</span></a>
          <a class="project-row" href="#contact"><span class="mono">03</span><div><h3>Open Infrastructure</h3><p>Reusable components that make collaborative work easier.</p></div><span class="arrow">↗</span></a>
        </div>
      </section>

      <section id="research" class="content-section">
        <div class="section-tag">03 — RESEARCH</div>
        <div class="research-layout"><div><h2>Explore first.<br />Publish second.</h2></div><div><p>We prototype across software, automation, data and human-computer interaction. The goal is not to predict the future — it is to make useful pieces of it.</p><div class="signal"><span></span><div><b>EXPERIMENTAL SIGNAL</b><small>Ideas in motion · systems under study</small></div></div></div></div>
      </section>

      <section id="open-source" class="content-section dark-panel">
        <div class="section-tag">04 — OPEN SOURCE</div>
        <div class="open-layout"><h2>Fork it.<br />Improve it.<br />Share it.</h2><div><p>Everything here is designed to be understandable, reusable and extendable. Good open source should make the next idea easier to build.</p><a class="text-link" href="https://github.com/opensourcelab-official" target="_blank" rel="noreferrer">View the organization on GitHub ↗</a></div></div>
      </section>

      <section id="contact" class="content-section contact-section">
        <div class="section-tag">05 — CONTACT</div>
        <h2>Have an idea worth<br /><span>building in the open?</span></h2>
        <a class="contact-mail" href="mailto:hello@opensourcelab.in">hello@opensourcelab.in ↗</a>
      </section>
    </main>

    <footer><span>© 2026 OpenSource Lab</span><span class="mono">OPEN / BUILD / SHARE</span></footer>

    <style>
      :global(*) { box-sizing: border-box; }
      :global(html) { scroll-behavior: smooth; }
      :global(body) { margin: 0; background: #090b10; color: #f3f5f7; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; overflow-x: hidden; }
      :global(body::selection) { background: #fff; color: #090b10; }
      a { color: inherit; text-decoration: none; }
      .noise { position: fixed; inset: 0; pointer-events: none; opacity: .035; z-index: 10; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.55'/%3E%3C/svg%3E"); }
      .grid { position: fixed; inset: 0; pointer-events: none; opacity: .11; background-image: linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px); background-size: 42px 42px; mask-image: linear-gradient(to bottom, black, transparent 90%); }
      .scanline { position: fixed; inset: -100% 0 0; height: 35%; pointer-events: none; background: linear-gradient(transparent, rgba(255,255,255,.035), transparent); animation: scan 12s linear infinite; z-index: 2; }
      @keyframes scan { to { transform: translateY(420%); } }
      .topbar { height: 72px; padding: 0 42px; border-bottom: 1px solid rgba(255,255,255,.09); display: flex; align-items: center; justify-content: space-between; position: fixed; top: 0; left: 0; right: 0; z-index: 20; backdrop-filter: blur(18px); background: rgba(9,11,16,.72); }
      .brand { display: inline-flex; align-items: center; gap: 12px; font-size: 14px; letter-spacing: -.02em; }
      .brand b { font-weight: 500; opacity: .55; }
      .brand-mark { width: 20px; height: 20px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; align-items: end; }
      .brand-mark span { display: block; background: #f3f5f7; border-radius: 1px; }.brand-mark span:nth-child(1){height:45%}.brand-mark span:nth-child(2){height:75%}.brand-mark span:nth-child(3){height:100%}
      nav { display: flex; gap: 28px; margin-left: 70px; } nav a { font-size: 12px; color: rgba(243,245,247,.62); transition: color .2s ease; } nav a:hover { color: #fff; }
      .status { font: 10px/1 monospace; letter-spacing: .15em; color: rgba(243,245,247,.62); }.status i { display:inline-block; width:6px; height:6px; background:#fff; border-radius:50%; margin-right:8px; box-shadow: 0 0 10px #fff; }
      .hero { min-height: 100vh; padding: 150px 7vw 90px; position: relative; display: flex; align-items: center; overflow: hidden; }
      .section-frame::before, .section-frame::after { content:""; position:absolute; inset:28px; border:1px solid rgba(255,255,255,.06); pointer-events:none; }
      .hero-copy { max-width: 720px; position:relative; z-index:3; }.eyebrow, .section-tag { font: 10px/1.2 monospace; letter-spacing:.2em; color: rgba(243,245,247,.5); }
      h1 { font-size: clamp(56px, 8vw, 118px); line-height: .91; letter-spacing: -.06em; margin: 24px 0; font-weight: 620; } h1 span, .contact-section h2 span { color: rgba(243,245,247,.34); }
      .lede { max-width: 550px; font-size: 17px; line-height: 1.65; color: rgba(243,245,247,.63); }
      .hero-actions { display:flex; gap:12px; margin-top:32px; flex-wrap:wrap; }.button { padding:13px 18px; border:1px solid rgba(255,255,255,.14); font-size:12px; border-radius:7px; transition:transform .2s, border-color .2s, background .2s; }.button:hover{transform:translateY(-2px);border-color:rgba(255,255,255,.35)} .primary{background:#f3f5f7;color:#090b10}.ghost{background:rgba(255,255,255,.03)}
      .hero-orbit { position:absolute; right: 5vw; width:min(43vw,560px); height:min(43vw,560px); min-width:320px; min-height:320px; top:50%; transform:translateY(-46%); opacity:.78; }.orbit{position:absolute;inset:0;border:1px solid rgba(255,255,255,.1);border-radius:50%;}.o1{transform:rotate(24deg) scaleY(.55);}.o2{transform:rotate(-38deg) scaleY(.55);}.o3{transform:rotate(86deg) scaleY(.55);}.core{position:absolute;inset:42%;border:1px solid rgba(255,255,255,.26);display:grid;place-items:center;border-radius:50%;font:11px monospace;letter-spacing:.2em;background:rgba(255,255,255,.02);box-shadow:0 0 80px rgba(255,255,255,.08);}
      .hud { position:absolute; z-index:4; font:9px monospace; letter-spacing:.12em; color:rgba(243,245,247,.35)}.hud-tl{top:48px;left:48px}.hud-tr{top:48px;right:48px}.hud-bl{bottom:48px;left:48px}.hud-br{bottom:48px;right:48px}
      .content-section { padding: 130px 10vw; border-top:1px solid rgba(255,255,255,.07); position:relative; }.dark-panel { background: linear-gradient(180deg, rgba(255,255,255,.02), rgba(255,255,255,.0)); }
      .section-head { display:grid; grid-template-columns:1fr 1fr; gap:80px; align-items:end; margin-top:24px; }.section-head h2,.research-layout h2,.open-layout h2,.contact-section h2 { font-size:clamp(40px,5vw,74px); line-height:.96; letter-spacing:-.05em; font-weight:560; margin:0; }.section-head p,.research-layout p,.open-layout p { max-width:560px; color:rgba(243,245,247,.58); line-height:1.7; font-size:16px; }
      .feature-grid { margin-top:80px; display:grid; grid-template-columns:repeat(3,1fr); border-top:1px solid rgba(255,255,255,.1); }.feature-grid article { padding:28px 26px; min-height:190px; border-right:1px solid rgba(255,255,255,.1); }.feature-grid article:last-child{border-right:0}.feature-grid span,.mono{font:10px monospace;color:rgba(243,245,247,.4);}.feature-grid h3{font-size:19px;font-weight:500;margin:48px 0 10px}.feature-grid p{margin:0;color:rgba(243,245,247,.5);line-height:1.6;font-size:13px;}
      .project-list { margin-top:55px; border-top:1px solid rgba(255,255,255,.1); }.project-row { display:grid; grid-template-columns:70px 1fr 40px; gap:20px; padding:28px 0; border-bottom:1px solid rgba(255,255,255,.1); align-items:center; transition:padding .25s, background .25s; }.project-row:hover{padding-left:14px;padding-right:14px;background:rgba(255,255,255,.02)}.project-row h3{margin:0 0 5px;font-size:22px;font-weight:500}.project-row p{margin:0;color:rgba(243,245,247,.45);font-size:13px}.arrow{font-size:20px;opacity:.45}
      .research-layout,.open-layout { display:grid; grid-template-columns:1fr 1fr; gap:100px; align-items:start; margin-top:32px; }.signal{margin-top:55px;border:1px solid rgba(255,255,255,.1);padding:18px;display:flex;gap:14px;align-items:center}.signal>span{width:8px;height:8px;border-radius:50%;background:#fff;box-shadow:0 0 14px rgba(255,255,255,.65)}.signal b,.signal small{display:block;font:10px monospace;letter-spacing:.08em}.signal small{margin-top:5px;color:rgba(243,245,247,.42)}.text-link{display:inline-block;margin-top:30px;border-bottom:1px solid rgba(255,255,255,.3);padding-bottom:7px;font-size:13px}
      .contact-section { min-height:70vh; display:flex; flex-direction:column; justify-content:center; }.contact-mail{font-size:clamp(20px,3vw,40px);margin-top:50px;display:inline-block;width:max-content;border-bottom:1px solid rgba(255,255,255,.28);padding-bottom:8px;}
      footer{padding:28px 42px;border-top:1px solid rgba(255,255,255,.08);display:flex;justify-content:space-between;color:rgba(243,245,247,.4);font-size:10px;}footer .mono{font-size:9px}
      @media(max-width:900px){nav{display:none}.topbar{padding:0 22px}.status{display:none}.hero{padding:130px 7vw 80px}.hero-orbit{opacity:.18;right:-18vw;width:80vw;height:80vw}.section-head,.research-layout,.open-layout{grid-template-columns:1fr;gap:24px}.feature-grid{grid-template-columns:1fr}.feature-grid article{border-right:0;border-bottom:1px solid rgba(255,255,255,.1)}.feature-grid article:last-child{border-bottom:0}.content-section{padding:95px 7vw}.section-frame::before,.section-frame::after{inset:16px}.hud-tl{left:28px}.hud-tr{right:28px}.hud-bl{left:28px}.hud-br{right:28px}h1{font-size:clamp(54px,16vw,94px)}.lede{font-size:15px}}
    </style>
  </body>
</html>
